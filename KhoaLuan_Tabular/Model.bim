          },
          {
            "type": "calculated",
            "name": "Royalty Excluding Tax ( VNĐ)",
            "dataType": "double",
            "isDataTypeInferred": true,
            "expression": "'Fact Royalty'[Royalty Excluding Tax]*1000"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
