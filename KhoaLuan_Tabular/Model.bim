                "in",
                "    Fact_Royalty"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Royalties Excluding Tax",
            "description": "Tổng tiền nhuận bút",
            "expression": "SUM('Fact Royalty'[Royalty Excluding Tax ( VNĐ)])",
            "formatString": "#,##0;-#,##0"
          },
          {
            "name": "Post Code Count",
            "description": "Số bài viết",
            "expression": " DISTINCTCOUNT('Fact Royalty'[Post Key])",
            "formatString": "#,##0;-#,##0"
          },
          {
            "name": "Post Code Count Level 1",
            "description": "Số bài viết được đánh giá hạng 1",
            "expression": " CALCULATE([Post Code Count], 'Dim Ranking'[Level]=1)",
            "formatString": "#,##0;-#,##0"
          },
          {
            "name": "Post Code Count Level 2",
            "description": "Số bài viết được đánh giá hạng 2",
            "expression": " CALCULATE([Post Code Count], 'Dim Ranking'[Level]=2)"
          },
          {
            "name": "Post Code Count Level 3",
            "description": "Số bài viết được đánh giá hạng 3",
            "expression": " CALCULATE([Post Code Count], 'Dim Ranking'[Level]=3)",
            "formatString": "#,##0;-#,##0"
          },
          {
            "name": "Post Code Count Level 4",
            "description": "Số bài viết được đánh giá hạng 4",
            "expression": " CALCULATE([Post Code Count], 'Dim Ranking'[Level]=4)",
            "formatString": "#,##0;-#,##0"
          }
        ]
